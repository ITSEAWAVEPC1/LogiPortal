# Neon Postgres — use the "pooled connection" string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (NextAuth) — generate with `openssl rand -base64 32` or `npx auth secret`.
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Stage 9 — customer portal. Optional; defaults to enabled. Set to "false" to
# disable the /portal route group and /api/portal/* without affecting the
# internal app.
CUSTOMER_PORTAL_ENABLED="true"

# Stage 10c — notifications.
# In-app notifications always work. Email is dispatched only when BOTH of these
# are set (Resend, https://resend.com — free tier). Leave disabled for local dev.
NOTIFICATIONS_EMAIL_ENABLED="false"
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="Seawave Ops <ops@seawave.example>"
# Shared secret for GET /api/cron/notifications (Vercel Cron sends it as a
# Bearer token). Generate with `openssl rand -hex 32`.
CRON_SECRET="replace-with-a-random-secret"
