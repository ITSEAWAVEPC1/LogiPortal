// Stage 0 — Foundation & Design System
// Models: User, Role, Branch, Session, FieldPermission (per docs/platform-development-plan.md Section 8)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection URL is no longer set here. Migrate/CLI reads it from
// prisma.config.ts; PrismaClient reads it via the driver adapter in
// src/lib/db/prisma.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  BRANCH_MANAGER
  DOER
  SALES
  ACCOUNTS
  CUSTOMER
}

enum FieldAccessLevel {
  NONE
  VIEW
  EDIT
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  organizations Organization[]
  enquiries     Enquiry[]
  quotations    Quotation[]
  jobs          Job[]

  @@map("branches")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Stage 7 — minimal additive down-payment on Stage 9's Customer row-scoping.
  // Nullable, no default. Only CUSTOMER users are ever linked, and only the
  // document-repository queries read it so far; Stage 9 promotes this into the
  // session and scopes Jobs/Quotations/Enquiries by it too.
  organizationId String?
  organization   Organization? @relation("OrganizationUsers", fields: [organizationId], references: [id])

  sessions             Session[]
  createdOrganizations Organization[] @relation("OrganizationCreatedBy")
  importBatches        ImportBatch[]
  enquiriesAsDoer      Enquiry[]      @relation("EnquiryDoer")
  enquiriesReviewed    Enquiry[]      @relation("EnquiryReviewedBy")

  createdQuotations            Quotation[]        @relation("QuotationCreatedBy")
  quotationsReviewed           Quotation[]        @relation("QuotationReviewedBy")
  quotationsCustomerApprovedBy Quotation[]        @relation("QuotationCustomerApprovedBy")
  quotationVersionsCreated     QuotationVersion[] @relation("QuotationVersionCreatedBy")
  quotationVersionsApproved    QuotationVersion[] @relation("QuotationVersionApprovedBy")

  createdJobs  Job[] @relation("JobCreatedBy")
  jobsReviewed Job[] @relation("JobReviewedBy")

  // Stage 5 — workflow engine
  workflowStepsCompleted JobWorkflowProgress[] @relation("WorkflowStepCompletedBy")
  workflowStepsApproved  JobWorkflowProgress[] @relation("WorkflowStepApprovedBy")
  jobAuditLogs           JobAuditLog[]         @relation("JobAuditActor")

  // Stage 7 — documents
  documentsCreated        Document[]        @relation("DocumentCreatedBy")
  documentsApproved       Document[]        @relation("DocumentApprovedBy")
  documentVersionsCreated DocumentVersion[] @relation("DocumentVersionCreatedBy")

  branchesAsSalesPerson         OrganizationBranch[]   @relation("BranchSalesPerson")
  branchesAsCollectionExecutive OrganizationBranch[]   @relation("BranchCollectionExecutive")
  branchAccountManagerFor       BranchAccountManager[] @relation("BranchAccountManagerUser")
  columnPreferences             UserColumnPreference[]

  // Stage 9 — customer portal cross-organization access attempts
  portalAccessLogs PortalAccessLog[]

  // Stage 10c — notifications
  notifications          Notification[]           @relation("UserNotifications")
  notificationPreference NotificationPreference?  @relation("UserNotificationPreference")

  @@map("users")
}

// Login-audit record, written by our own sign-in callback. NextAuth's Credentials
// provider only supports the "jwt" session strategy (no database sessions for
// credentials logins), so this table does not back live auth sessions — it's an
// append-only login log, and a head start on Stage 10's audit trail.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  // Stage 10d — the /audit "Logins" tab orders by createdAt; userId for lookups.
  @@index([userId])
  @@index([createdAt])
  @@map("sessions")
}

// Encodes the Section 4.3 job-detail field-permission matrix as data.
// (role, resource, fieldGroup) -> access. Queried at request time by
// src/lib/permissions/field-permissions.ts.
model FieldPermission {
  id         String           @id @default(cuid())
  role       Role
  resource   String
  fieldGroup String
  access     FieldAccessLevel
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([role, resource, fieldGroup])
  @@map("field_permissions")
}

// Per-year monotonic counter for the unified RFQ reference number
// (RFQ-DDMMYY-NNNN). Resets yearly because the row key includes the calendar
// year. One logical scope ("RFQ") is shared by enquiries, quotations and jobs
// so a freshly-minted number can never collide with one inherited down the
// Enquiry -> Quotation -> Job spine. Read + incremented with a single upsert
// inside the caller's $transaction — see src/lib/reference/generate-reference.ts.
model ReferenceCounter {
  id        String   @id @default(cuid())
  scope     String // "RFQ" — kept as a column so a second series can be added later
  year      Int
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, year])
  @@map("reference_counters")
}

// ---------------------------------------------------------------------------
// Stage 1 — Master Data + Bulk Import Wizard
// ---------------------------------------------------------------------------

model Organization {
  id                 String   @id @default(cuid())
  name               String
  alias              String?
  contactPersonName  String?
  contactPersonPhone String?
  contactPersonEmail String?
  city               String?
  state              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Role flags — one Organization record can play multiple roles at once
  // (Customer Master v2, Section: "Organization all available options").
  isShipper   Boolean @default(false)
  isConsignee Boolean @default(false)
  isAgent     Boolean @default(false)
  isCarrier   Boolean @default(false)
  isService   Boolean @default(false)
  isGlobal    Boolean @default(false)

  // Billing tab default; individual OrganizationBillType rows can still carry
  // their own currency-relevant behavior via Bank Details.
  defaultCurrency String?

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  createdById String?
  createdBy   User?   @relation("OrganizationCreatedBy", fields: [createdById], references: [id])

  // Traceability: which bulk-import batch created this row, if any (null = created manually).
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  kycDetail  KycDetail?
  enquiries  Enquiry[]
  quotations Quotation[]
  jobs       Job[]

  // Stage 7 — CUSTOMER users linked to this org for the document repository
  // read path (see User.organizationId).
  users User[] @relation("OrganizationUsers")

  branches            OrganizationBranch[]
  customerAccountInfo CustomerAccountInfo?
  vendorAccountInfo   VendorAccountInfo?
  billTypes           OrganizationBillType[]
  // Reverse side of OrganizationBillType.billToOrganization — other orgs that
  // name this Organization as their "Bill To: Other" target.
  billToForOthers     OrganizationBillType[] @relation("BillToOrganization")

  @@index([branchId])
  @@index([name])
  @@map("organizations")
}

// One-to-one with Organization. Kept separate per Section 5.1's framing of
// "Company KYC" as a distinct sub-object, and so GST uniqueness gets its own
// focused index without cluttering Organization's common-path search columns.
model KycDetail {
  id             String @id @default(cuid())
  organizationId String @unique

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Optional at creation (Section 5.1 has no approval gate; real onboarding
  // often starts before GST is on hand) but unique when present — a Postgres
  // unique index allows multiple NULLs, so this doesn't block GST-less orgs.
  gstNumber String? @unique
  panNumber String?
  tanNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("kyc_details")
}

enum ImportEntityType {
  CUSTOMER
  JOB // reserved for Stage 4's historical-Job import extension — unused in Stage 1
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ImportBatch {
  id         String           @id @default(cuid())
  entityType ImportEntityType @default(CUSTOMER)
  fileName   String

  status        ImportBatchStatus @default(PENDING)
  columnMapping Json?
  totalRows     Int               @default(0)
  validRows     Int               @default(0)
  invalidRows   Int               @default(0)
  importedRows  Int               @default(0)
  failureReason String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  rowErrors     ImportRowError[]
  organizations Organization[]
  jobs          Job[]

  @@index([uploadedById])
  @@index([status])
  @@index([entityType])
  @@map("import_batches")
}

model ImportRowError {
  id            String      @id @default(cuid())
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  rowNumber Int // 1-based, matches the row's position in the source file
  rawData   Json // the row as parsed, surfaced in the CSV download
  errors    Json // Array<{ field: string; message: string }>

  createdAt DateTime @default(now())

  @@index([importBatchId])
  @@map("import_row_errors")
}

// ---------------------------------------------------------------------------
// Stage 2 — Enquiry Capturing
// ---------------------------------------------------------------------------

enum ShipmentType {
  IMPORT
  EXPORT
}

enum ServiceType {
  FREIGHT_FORWARDING
  CUSTOMS_CLEARANCE
  TRANSPORTATION
  WAREHOUSING
  EXIM_CONSULTANCY
}

enum EnquiryStatus {
  DRAFT
  OPEN
  READY_FOR_QUOTATION
  NEEDS_CORRECTION
}

enum CargoMode {
  LCL_AIR
  FCL
}

enum TransportDeliveryType {
  LOADED
  DESTUFF
}

model Enquiry {
  id     String        @id @default(cuid())
  status EnquiryStatus @default(DRAFT)

  // Numeric part of the LEGACY human-facing reference (ENQ-{year}-{sequenceNumber,
  // padded}). Global autoincrement, not reset per year — see
  // docs/stage-checklists/stage-2.md for the tradeoff. Kept as the display
  // fallback when referenceNo is null (pre-backfill rows).
  sequenceNumber Int @default(autoincrement())

  // Unified reference RFQ-DDMMYY-NNNN, minted once here and reused verbatim by
  // this enquiry's Quotation and Job. refYear/refSequence are the structured
  // parts (NNNN is a per-year counter). Additive; nullable until backfilled.
  referenceNo String? @unique
  refYear     Int?
  refSequence Int?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Snapshot, editable per-enquiry — seeded from Organization on selection
  // but intentionally not re-synced if the org's saved contact changes later
  // (the RFQ caller isn't always the org's registered contact).
  contactPersonName  String?
  contactPersonPhone String?
  contactPersonEmail String?

  shipmentType ShipmentType?
  serviceTypes ServiceType[] @default([])
  rfqReason    String?

  // "Doer Name" (source doc's literal field label) — auto-set to the session
  // user at creation, never client-supplied. Can be a Sales-role user per
  // Section 5.2 ("Sales or Doer starts a new Enquiry").
  doerId String
  doer   User   @relation("EnquiryDoer", fields: [doerId], references: [id])

  reviewedById String?
  reviewedBy   User?     @relation("EnquiryReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  freightDetail   EnquiryFreightDetail?
  customsDetail   EnquiryCustomsDetail?
  transportDetail EnquiryTransportDetail?

  // Reverse side of QuotationEnquiry.enquiryId (@unique) — an Enquiry can be
  // bundled into at most one Quotation, ever. See Stage 3.
  quotationEnquiry QuotationEnquiry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([refYear, refSequence])
  @@index([branchId])
  @@index([organizationId])
  @@index([status])
  @@index([doerId])
  @@map("enquiries")
}

model EnquiryFreightDetail {
  id        String  @id @default(cuid())
  enquiryId String  @unique
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  incoterm        String?
  portOfLoading   String?
  portOfDischarge String?
  cargoMode       CargoMode?

  // LCL & Air
  packageCount Int?
  dimensions   String?
  weight       Float?

  // FCL
  fclWeight      Float?
  containerType  String?
  containerCount Int?

  // ODC (over-dimensional cargo) — only meaningful when cargoMode = FCL
  isOdc               Boolean @default(false)
  odcDimensions       String?
  odcPackageCount     Int?
  odcPerPackageWeight Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enquiry_freight_details")
}

model EnquiryCustomsDetail {
  id        String  @id @default(cuid())
  enquiryId String  @unique
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  hsCode    String?
  commodity String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enquiry_customs_details")
}

model EnquiryTransportDetail {
  id        String  @id @default(cuid())
  enquiryId String  @unique
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  pickup      String?
  destination String?
  cargoMode   CargoMode?

  // LCL & Air
  packageCount Int?
  dimensions   String?
  weight       Float?

  // FCL — note: no container-count field here, unlike Freight Forwarding's FCL block
  fclWeight     Float?
  containerType String?
  deliveryType  TransportDeliveryType?

  // ODC — only meaningful when cargoMode = FCL
  isOdc               Boolean @default(false)
  odcDimensions       String?
  odcPackageCount     Int?
  odcPerPackageWeight Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enquiry_transport_details")
}

// ---------------------------------------------------------------------------
// Customer Master v2 — Organization enhancement (Branches, Account Info,
// Billing, Bank Details, per-user list column preferences). Additive only.
// See docs/stage-checklists/customer-master-v2.md.
// ---------------------------------------------------------------------------

enum BankAccountKind {
  PAYABLE
  RECEIVABLE
}

enum BillToType {
  DIRECT
  OTHER
}

// Only "Transaction Date" was visible in the reference screenshot (the
// dropdown wasn't opened in the recording) — INVOICE_DATE/BILL_DATE are a
// reasonable placeholder set for a freight-billing due-date basis, flagged
// in the stage checklist as an assumption to confirm against the real system.
enum DueDateBasis {
  TRANSACTION_DATE
  INVOICE_DATE
  BILL_DATE
}

// Same caveat as DueDateBasis — only "No Grouping of Invoice Charges" was
// visible as the selected value; the other members are placeholders.
enum ClubChargesOption {
  NO_GROUPING
  GROUP_BY_SHIPMENT
  GROUP_BY_JOB
}

// A customer/vendor organization's own branch offices — distinct from the
// `Branch` model (Seawave's internal offices used for User/Organization
// assignment). One Organization has many OrganizationBranches.
model OrganizationBranch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  branchName    String
  address       String?
  isDefault     Boolean @default(false)
  isDeactivated Boolean @default(false)
  country       String?
  state         String?
  city          String?
  postalCode    String?
  telephone     String?
  fax           String?
  website       String?
  email         String?
  lobWise       Boolean @default(false)
  // Free-text rather than an enum — only "Standard" was visible in the
  // reference screen's dropdown (never opened), so the full option set is
  // unconfirmed. Defaults to the one confirmed value.
  taxableType   String  @default("Standard")

  salesPersonId String?
  salesPerson   User?   @relation("BranchSalesPerson", fields: [salesPersonId], references: [id])

  collectionExecutiveId String?
  collectionExecutive   User?   @relation("BranchCollectionExecutive", fields: [collectionExecutiveId], references: [id])

  addresses       BranchAddress[]
  contacts        BranchContact[]
  accountManagers BranchAccountManager[]
  bankAccounts    OrganizationBankAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("organization_branches")
}

// Secondary addresses beyond the branch's own (reference screen's "More
// Addresses" tab), e.g. a distinct Delivery address.
model BranchAddress {
  id       String             @id @default(cuid())
  branchId String
  branch   OrganizationBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  addressType String
  name        String?
  address     String?
  city        String?
  postalCode  String?
  state       String?
  telephone   String?
  fax         String?
  email       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@map("branch_addresses")
}

model BranchContact {
  id       String             @id @default(cuid())
  branchId String
  branch   OrganizationBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  contactName      String
  titleDesignation String?
  department       String?
  mobile           String?
  telephone        String?
  email            String?
  isPrimary        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@map("branch_contacts")
}

// "For" category (e.g. "Consignee Sea" / "Consignee Land") is free-text —
// only two example rows were visible in the reference screen; the full
// category list is unconfirmed. One manager per (branch, category).
model BranchAccountManager {
  id       String             @id @default(cuid())
  branchId String
  branch   OrganizationBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  forCategory String

  managerUserId String?
  manager       User?   @relation("BranchAccountManagerUser", fields: [managerUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, forCategory])
  @@map("branch_account_managers")
}

model OrganizationBankAccount {
  id       String             @id @default(cuid())
  branchId String
  branch   OrganizationBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  accountKind         BankAccountKind
  bankName            String
  bankBranch          String?
  accountNumber       String
  ifsc                String?
  // Only meaningful when accountKind = RECEIVABLE, per the reference screen
  // (the Payable Details grid has no currency column).
  transactionCurrency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@map("organization_bank_accounts")
}

// Customer-side Account Info (Account Info > General > Customer sub-tab).
// No prior Decimal usage in this schema and no accounting stage built yet —
// Float keeps this consistent with the rest of the app rather than adding
// Decimal/JSON-serialization handling for the first money field.
model CustomerAccountInfo {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  creditLimit                 Float   @default(0)
  isUnlimitedCredit           Boolean @default(false)
  cashOnDelivery              Boolean @default(false)
  includeWipShipmentInOverdue Boolean @default(false)
  isCreditOnHold              Boolean @default(false)
  creditOnHoldRemark          String?
  receivableCreditPeriodDays  Int?
  customerGLCode              String?
  notificationEmails          String?
  currency                    String?
  tdsReceivable               Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_account_infos")
}

// Vendor-side Account Info (Account Info > General > Vendor sub-tab).
model VendorAccountInfo {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  creditLimit             Float        @default(0)
  isUnlimitedCredit       Boolean      @default(false)
  payableCreditPeriodDays Int?
  dueDateCalculatedOn     DueDateBasis @default(TRANSACTION_DATE)
  vendorGLCode            String?
  notificationEmails      String?
  currency                String?
  isPaymentOnHold         Boolean      @default(false)
  tdsPayable              Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vendor_account_infos")
}

// Admin-configurable master list (Billing tab's Bill Type dropdown source).
// Seeded from the reference screen's visible list — see prisma/seed.ts.
model BillType {
  id       String  @id @default(cuid())
  name     String
  code     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationBillTypes OrganizationBillType[]

  @@map("bill_types")
}

model OrganizationBillType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  billTypeId String
  billType   BillType @relation(fields: [billTypeId], references: [id])

  dueAfterDays         Int?
  overrideCreditPeriod Boolean    @default(false)
  billTo               BillToType @default(DIRECT)

  // Set only when billTo = OTHER.
  billToOrganizationId String?
  billToOrganization   Organization? @relation("BillToOrganization", fields: [billToOrganizationId], references: [id])

  clubCharges ClubChargesOption @default(NO_GROUPING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, billTypeId])
  @@index([organizationId])
  @@map("organization_bill_types")
}

// Backs the Organization list's "Customize Columns" picker — persists which
// columns a user has selected, per screen, so it survives reload. Generic by
// screenKey so Reports/other list screens can reuse it later without a new
// model (per the task's note that this pattern likely gets reused).
model UserColumnPreference {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenKey String
  columns   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, screenKey])
  @@map("user_column_preferences")
}

// ---------------------------------------------------------------------------
// Stage 3 — Quotation Module
//
// Enquiry <-> Quotation is many-to-many via QuotationEnquiry, not 1:1: a
// Sales user bundles one or more READY_FOR_QUOTATION Enquiries (typically
// same Organization) into a single combined Quotation. An Enquiry can only
// ever be attached to one Quotation (QuotationEnquiry.enquiryId is unique).
// See docs/stage-checklists/stage-3.md for the full rationale.
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  NEEDS_CORRECTION
  APPROVED
  SENT
  CUSTOMER_APPROVED
  CONVERTED
}

enum QuotationChargeCategory {
  FREIGHT
  CUSTOMS_CLEARANCE
  TRANSPORTATION
  REIMBURSEMENT
}

model Quotation {
  id             String          @id @default(cuid())
  status         QuotationStatus @default(DRAFT)
  // Numeric part of the LEGACY human-facing reference (QUO-{year}-{sequenceNumber,
  // padded}) — same global-autoincrement pattern as Enquiry.sequenceNumber.
  // Kept as the display fallback when referenceNo is null.
  sequenceNumber Int             @default(autoincrement())

  // Unified reference — inherited verbatim from the primary (earliest-created)
  // bundled Enquiry's referenceNo; sourceReference records the other bundled
  // enquiry refs. See src/lib/reference/generate-reference.ts.
  referenceNo     String? @unique
  refYear         Int?
  refSequence     Int?
  sourceReference String?

  // Denormalized from the attached Enquiries' Organization — enforced
  // same-org at create time so a Quotation always has one clear billing
  // target/PDF recipient even though it can bundle several shipments.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById String
  createdBy   User   @relation("QuotationCreatedBy", fields: [createdById], references: [id])

  // Points at the QuotationVersion currently in effect (the one editable, or
  // the one most recently approved/sent). Editing after approval clones into
  // versionNumber + 1 rather than mutating history — see stage-3.md.
  currentVersionNumber Int @default(1)

  reviewedById String?
  reviewedBy   User?     @relation("QuotationReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  sentAt DateTime?

  // Customer approval recorded manually by Sales (Section 5.3 step 4) — not
  // a customer-portal action, since Customer row-scoping doesn't exist until
  // Stage 9.
  customerApproved     Boolean   @default(false)
  customerApprovedAt   DateTime?
  customerApprovedNote String?
  customerApprovedById String?
  customerApprovedBy   User?     @relation("QuotationCustomerApprovedBy", fields: [customerApprovedById], references: [id])

  convertedAt DateTime?

  enquiries QuotationEnquiry[]
  versions  QuotationVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([refYear, refSequence])
  @@index([branchId])
  @@index([organizationId])
  @@index([status])
  @@map("quotations")
}

// Join row between Quotation and Enquiry. jobSnapshot is populated per-row
// at convert-to-Job time (one JSON snapshot per Enquiry in the bundle, not
// one blob on the Quotation — see stage-3.md); Stage 4 consumes it to build
// the real Job with zero re-entry.
model QuotationEnquiry {
  id String @id @default(cuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  enquiryId String  @unique
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id])

  jobSnapshot Json?
  convertedAt DateTime?

  // Reverse side of Job.quotationEnquiryId (@unique) — the one Job built from
  // this converted enquiry (Stage 4). Null until a Doer creates it.
  job Job?

  createdAt DateTime @default(now())

  @@index([quotationId])
  @@map("quotation_enquiries")
}

model QuotationVersion {
  id String @id @default(cuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  versionNumber Int
  currency      String @default("INR")
  // Denormalized sum of this version's line items, recomputed on every
  // line-item write — avoids re-summing on every read.
  totalAmount   Float  @default(0)

  createdById String
  createdBy   User   @relation("QuotationVersionCreatedBy", fields: [createdById], references: [id])

  // Stamped when a Branch Manager approves this specific version — a later
  // edit clones into a new version rather than clearing these, so approval
  // history per version is preserved permanently.
  approvedById String?
  approvedBy   User?     @relation("QuotationVersionApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  lineItems QuotationLineItem[]

  createdAt DateTime @default(now())

  @@unique([quotationId, versionNumber])
  @@map("quotation_versions")
}

model QuotationLineItem {
  id String @id @default(cuid())

  quotationVersionId String
  quotationVersion   QuotationVersion @relation(fields: [quotationVersionId], references: [id], onDelete: Cascade)

  category    QuotationChargeCategory
  description String
  rate        Float?
  quantity    Float?
  amount      Float
  currency    String
  sortOrder   Int                     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quotationVersionId])
  @@map("quotation_line_items")
}

// ---------------------------------------------------------------------------
// Stage 4 — Consignment / Job Creation + Historical Job Import
// A Job is built either from a CONVERTED Quotation's per-enquiry jobSnapshot
// (origin QUOTATION, zero re-entry), created directly by a Doer (origin
// DIRECT), or migrated via the bulk import wizard (origin IMPORTED). The Doer
// completes the consignment fields; a Branch Manager final-review gate moves
// it to WORKFLOW_IN_PROGRESS (the workflow engine itself is Stage 5/6).
// Additive only. See docs/stage-checklists/stage-4.md.
// ---------------------------------------------------------------------------

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CORRECTION
  WORKFLOW_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobOrigin {
  QUOTATION
  DIRECT
  IMPORTED
}

// Stage 6 — second template-selection dimension for Export jobs, folded into
// WorkflowTemplate.incotermKey as a suffix ("CIF-DOCK", "CIF-FACTORY").
enum ExportStuffingType {
  NONE
  DOCK
  FACTORY
}

model Job {
  id     String    @id @default(cuid())
  status JobStatus @default(DRAFT)
  origin JobOrigin @default(QUOTATION)

  // Numeric part of the LEGACY human-facing reference (JOB-{year}-{sequenceNumber,
  // padded}) — same global-autoincrement pattern as Enquiry/Quotation. Kept as
  // the display fallback when referenceNo is null.
  sequenceNumber Int @default(autoincrement())

  // Unified reference. origin=QUOTATION: inherited verbatim from the originating
  // Enquiry's referenceNo (sourceReference = parent quotation ref). origin=DIRECT
  // or IMPORTED: freshly minted from the shared RFQ counter, sourceReference null.
  referenceNo     String? @unique
  refYear         Int?
  refSequence     Int?
  sourceReference String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Import vs Export drives which consignment field set is required at submit.
  shipmentType ShipmentType
  serviceTypes ServiceType[] @default([])

  // Free-text (EXW/FOB/CIF/DDP/DDU/...), same as EnquiryFreightDetail.incoterm.
  // Stage 5/6 reads this to attach the workflow template.
  incoterm String?

  // Stage 6 — which stuffing track applies (Export + Transportation service
  // only). Null = never asked (all Import jobs, and pre-Stage-6 Export jobs);
  // NONE = asked, no stuffing service. Distinct from NONE so a submit-time
  // check can tell "not applicable" from "not yet answered".
  exportStuffingType ExportStuffingType?

  // Set only for origin = QUOTATION — one Job per converted enquiry.
  quotationEnquiryId String?           @unique
  quotationEnquiry   QuotationEnquiry? @relation(fields: [quotationEnquiryId], references: [id])

  createdById String
  createdBy   User   @relation("JobCreatedBy", fields: [createdById], references: [id])

  // Branch Manager final-review gate (skipped for origin = IMPORTED).
  reviewedById String?
  reviewedBy   User?     @relation("JobReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  // Consignment fields the Doer completes (source PDF pages 3 & 5, plan 5.4).
  agentDetails     String?
  placeOfReceipt   String?
  portOfLoading    String?
  portOfDischarge  String?
  placeOfDelivery  String?
  shippingLineName String?
  cfsName          String?
  vesselName       String?
  voyageNumber     String?
  freeDaysAtPod    Int?
  totalGrossWeight Float?
  totalNetWeight   Float?
  totalPackages    Int?
  volumeCbm        Float?
  commodity        String?
  hsCode           String?

  // Charges field group — full quotation line-item set copied in as an
  // editable snapshot (no automatic per-shipment split; assumption carried
  // forward from Stage 3). Editable later only by roles with charges = EDIT.
  charges         Json?
  chargesCurrency String?
  quotedTotal     Float?

  // Duty payment field group — kept shallow here; Stage 6 deepens the
  // DDP/DDU landed-cost visibility rules.
  dutyPaymentLiability String?
  dutyAmount           Float?
  dutyPaidBy           String?

  // Internal notes / audit trail field group.
  internalNotes String?

  // Stage 10b — delivery SLA tracking, part of the workflowStatus field group.
  // expectedDeliveryDate is seeded from the ETA-at-POD workflow step
  // (eta_discharge_port / export_eta_to_pod) and editable by ADMIN/BM/DOER.
  // actualDeliveryDate is stamped when the final ("Delivered") step completes.
  // On-time = actualDeliveryDate <= expectedDeliveryDate (both set).
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?

  // Traceability: which bulk-import batch created this row, if any.
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])

  shipperDetail     ShipperDetail?
  consigneeDetail   ConsigneeDetail?
  notifyPartyDetail NotifyPartyDetail?
  containers        ContainerDetail[]

  // Stage 5 — workflow engine
  workflowProgress JobWorkflowProgress[]
  auditLogs        JobAuditLog[]

  // Stage 7 — generated + uploaded documents for this job
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([refYear, refSequence])
  @@index([branchId])
  @@index([organizationId])
  @@index([status])
  @@index([shipmentType])
  @@index([createdById])
  // Stage 10b — branch performance / revenue reports bucket by (branch, createdAt).
  @@index([branchId, createdAt])
  // Stage 10d — the revenue report's per-customer filter.
  @@index([organizationId, createdAt])
  @@map("jobs")
}

// Shipper / Consignee / Notify Party are three separate 1:1 detail tables
// (mirrors Stage 2's three EnquiryXDetail tables, not one polymorphic table).
model ShipperDetail {
  id    String @id @default(cuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name          String?
  address       String?
  contactPerson String?
  phone         String?
  email         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shipper_details")
}

model ConsigneeDetail {
  id    String @id @default(cuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name          String?
  address       String?
  contactPerson String?
  phone         String?
  email         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consignee_details")
}

model NotifyPartyDetail {
  id    String @id @default(cuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  name          String?
  address       String?
  contactPerson String?
  phone         String?
  email         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notify_party_details")
}

// Repeatable container rows per Job (add/edit/remove, mirroring the Quotation
// line-item editor). containerType is free-text; count allows "3 x 40HC"
// style rows without forcing one row per physical container.
model ContainerDetail {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  containerNumber String?
  sealNumber      String?
  containerType   String?
  count           Int?    @default(1)
  grossWeight     Float?
  tareWeight      Float?
  netWeight       Float?
  packageCount    Int?
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@map("container_details")
}

// ---------------------------------------------------------------------------
// Stage 5 — Import Workflow Engine (Ex-Works & FOB tracks)
//
// A WorkflowTemplate is a data-defined step sequence keyed by
// (shipmentType, incotermKey). When a Branch Manager approves a Job, the
// matching template's active steps are copied into JobWorkflowProgress rows
// (denormalized snapshot — later template edits don't touch in-flight Jobs).
// Every step action appends a JobAuditLog row; the log is append-only (no
// PATCH/DELETE route exists). Export tracks (CIF/DDP/DDU) were added in
// Stage 6, reusing these same models unchanged in shape. See
// docs/stage-checklists/stage-5.md and stage-6.md.
// Additive only.
// ---------------------------------------------------------------------------

enum WorkflowStepStatus {
  PENDING // not yet reachable / not started
  IN_PROGRESS // current step, owner working on it
  PENDING_APPROVAL // owner submitted a two-actor gate step, waiting on approverRole
  COMPLETED
  SKIPPED // Stage 6 "if required" steps (e.g. Empty Yard Amendment); unused by Import
}

model WorkflowTemplate {
  id           String       @id @default(cuid())
  name         String // "Import — Ex-Works", "Export — CIF — Dock Stuffing", ...
  shipmentType ShipmentType // IMPORT | EXPORT
  // Uppercased Incoterm bucket matched against Job.incoterm ("EXW" | "FOB" |
  // "CIF" | "DDP" | "DDU"), with an Export stuffing-type suffix folded in
  // ("CIF-DOCK" | "CIF-FACTORY") — see src/lib/workflow/types.ts.
  incotermKey  String
  isActive     Boolean      @default(true)

  steps       WorkflowStep[]
  jobProgress JobWorkflowProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shipmentType, incotermKey])
  @@map("workflow_templates")
}

model WorkflowStep {
  id         String           @id @default(cuid())
  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // Stable machine key ("etd_from_pol", "draft_hbl_approval", ...) — the
  // JOB_WORKFLOW_STEP_FIELDS validation map and the engine key off this,
  // never the label or sortOrder (both admin-editable).
  stepKey   String
  label     String
  sortOrder Int

  ownerRole      Role // who completes / enters this step
  approverRole   Role? // set only for a two-actor gate (Draft HBL -> BRANCH_MANAGER)
  isApprovalGate Boolean @default(false) // true iff approverRole set; drives UI emphasis
  isActive       Boolean @default(true) // soft-deactivate; no hard delete (app convention)
  isFinal        Boolean @default(false) // completing this step flips Job.status -> COMPLETED
  isSkippable    Boolean @default(false) // Stage 6 "if required" steps; enables the skip action

  progress JobWorkflowProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, stepKey])
  @@index([templateId])
  @@map("workflow_steps")
}

model JobWorkflowProgress {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  templateId String
  template   WorkflowTemplate @relation(fields: [templateId], references: [id])
  stepId     String
  step       WorkflowStep     @relation(fields: [stepId], references: [id])

  // Denormalized snapshot of the step at attach time — an admin template
  // edit afterward never mutates an in-flight Job's sequence.
  stepKey   String
  label     String
  sortOrder Int

  status WorkflowStepStatus @default(PENDING)
  // Per-step captured fields (a single date, HBL No./Date, the 9 Freight
  // Certificate figures, ...). Validated per stepKey by
  // src/lib/validation/workflow.ts; opaque at the DB layer (like Job.charges).
  data   Json?

  completedById String?
  completedBy   User?     @relation("WorkflowStepCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?
  approvedById  String?
  approvedBy    User?     @relation("WorkflowStepApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  reviewNote    String? // gate-rejection reason

  // Stage 7 — documents optionally tied to the step that produces/needs them
  // (e.g. the MBL Copy uploaded from the MBL Details step). Optional link only;
  // the document and step state machines stay independent.
  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, stepId])
  @@index([jobId])
  @@map("job_workflow_progress")
}

// Append-only. No updatedAt, and no PATCH/DELETE route anywhere in the app.
// Stage 5 writes workflow-step transitions + job.completed; Stage 10's audit
// viewer reads it (and IntegrationSyncLog).
model JobAuditLog {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  actorId String
  actor   User   @relation("JobAuditActor", fields: [actorId], references: [id])

  // "workflow.attached" | "workflow.step.submitted" | "workflow.step.completed"
  // | "workflow.step.approved" | "workflow.step.rejected"
  // | "workflow.step.reverted" | "workflow.step.skipped" | "job.completed"
  action  String
  stepKey String?
  detail  Json? // { from, to, note, data } — free shape, like ImportRowError.errors

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([createdAt])
  // Stage 10d — the /audit "Job activity" tab filters by actor.
  @@index([actorId])
  @@map("job_audit_logs")
}

// ---------------------------------------------------------------------------
// Stage 7 — Document Generation & Management
//
// Five generated document kinds (HBL, MBL, Freight Certificate, Delivery
// Order, Invoice) plus free-form uploads, each tied to a Job, permission-
// scoped per plan §4.3, versioned, and regenerable from a retained
// sourceSnapshot. File bytes live in DocumentVersion.bytes (Postgres) behind
// src/lib/pdf/document-storage.ts so a later swap to Vercel Blob is a
// one-file change. Generation is synchronous with a 3-attempt retry loop
// (no queue infra yet); a failed render falls back to an HTML preview, same
// as the Stage 3 Quotation PDF. Additive only.
// See docs/stage-checklists/stage-7.md.
// ---------------------------------------------------------------------------

enum DocumentKind {
  HBL
  MBL
  FREIGHT_CERTIFICATE
  DELIVERY_ORDER
  INVOICE
  OTHER // free-form uploaded document (Packing List, Certificate of Origin, ...)
}

enum DocumentOrigin {
  GENERATED // produced by the PDF engine from Job data
  UPLOADED // a file a user uploaded
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum DocumentGenerationStatus {
  NOT_APPLICABLE // uploaded documents
  SUCCEEDED
  FAILED // all 3 render attempts failed — client renders the HTML fallback
}

// Seeded lookup (BillType twin). The 5 built-ins are isGeneratable; an admin
// can add upload-only categories at /settings/document-types, always
// kind = OTHER + isGeneratable = false.
model DocumentType {
  id                     String       @id @default(cuid())
  code                   String       @unique // stable dispatch key: "HBL", "MBL", ...
  name                   String
  kind                   DocumentKind
  isFinancial            Boolean      @default(false) // INVOICE + FREIGHT_CERTIFICATE — hidden from SALES
  isGeneratable          Boolean      @default(false) // has a PDF template
  customerVisibleDefault Boolean      @default(false)
  isActive               Boolean      @default(true)
  sortOrder              Int          @default(0)

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("document_types")
}

model Document {
  id             String   @id @default(cuid())
  // Numeric part of the human-facing reference (DOC-{year}-{sequenceNumber,
  // padded}) — same global-autoincrement pattern as Job/Quotation.
  sequenceNumber Int      @default(autoincrement())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  kind        DocumentKind // denormalized from the type for easy filtering
  origin      DocumentOrigin
  title       String
  isFinancial Boolean        @default(false) // frozen from the type at create time

  status             DocumentStatus @default(DRAFT)
  sharedWithCustomer Boolean        @default(false) // only APPROVED + shared docs reach a CUSTOMER
  isActive           Boolean        @default(true) // soft delete (no DELETE verb anywhere)

  // Optional tie to the workflow step that produced/needs this document.
  jobWorkflowProgressId String?
  jobWorkflowProgress   JobWorkflowProgress? @relation(fields: [jobWorkflowProgressId], references: [id])

  // Points at the DocumentVersion currently in effect — regeneration / a new
  // upload clones into currentVersionNumber + 1 rather than mutating history
  // (mirrors Quotation.currentVersionNumber).
  currentVersionNumber Int               @default(1)
  versions             DocumentVersion[]

  createdById String
  createdBy   User   @relation("DocumentCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("DocumentApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  reviewNote   String? // rejection reason

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([kind])
  @@index([status])
  @@map("documents")
}

model DocumentVersion {
  id         String @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  versionNumber Int

  fileName    String
  contentType String @default("application/pdf")
  byteSize    Int
  bytes       Bytes? // the file itself; null when a GENERATED version failed all attempts

  // GENERATED versions: the exact Job data used, kept for safe regeneration
  // (plan's "source-data snapshot retained per document"). Opaque JSON, like
  // Job.charges / JobWorkflowProgress.data.
  sourceSnapshot     Json?
  generationStatus   DocumentGenerationStatus @default(NOT_APPLICABLE)
  generationError    String?
  generationAttempts Int                      @default(0)

  createdById String
  createdBy   User   @relation("DocumentVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

// ---------------------------------------------------------------------------
// Stage 9 — Customer Portal
//
// The customer-facing portal is a read-only, strictly organization-scoped view
// of a customer's own Jobs / Quotations / shared Documents. Every denied
// cross-organization access attempt (a customer opening another org's job by
// direct URL, or requesting a document/PDF that isn't theirs) is recorded
// here — the plan §8 Stage 9 acceptance criterion ("log any attempted
// violation"). Append-only, no mutation/DELETE route, same convention as
// JobAuditLog. Also feeds Stage 10's audit-trail viewer.
// ---------------------------------------------------------------------------

enum PortalAccessOutcome {
  DENIED_CROSS_ORG // resource belongs to a different organization
  DENIED_UNLINKED // the customer user has no organization link
  DENIED_NOT_FOUND // resource id does not resolve at all
}

model PortalAccessLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  viewerOrgId  String? // the customer user's own organization at the time
  path         String // the request path that was blocked
  resourceType String? // "job" | "quotation" | "document"
  resourceId   String?
  outcome      PortalAccessOutcome

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("portal_access_logs")
}

// ---------------------------------------------------------------------------
// Stage 10c — Notifications
//
// One Notification row is BOTH the in-app item and the email-outbox row (the
// email* columns are the durable queue). Drained after a mutating request via
// Next's after() and, as a durability backstop, by GET /api/cron/notifications.
// Email is dark until RESEND_API_KEY + NOTIFICATIONS_EMAIL_ENABLED are set
// (src/lib/config/flags.ts); until then rows are created with emailStatus =
// SKIPPED. No SMS.
// ---------------------------------------------------------------------------

enum NotificationType {
  WORKFLOW_STEP_SUBMITTED
  WORKFLOW_STEP_APPROVED
  WORKFLOW_STEP_REJECTED
  JOB_WORKFLOW_STARTED
  JOB_COMPLETED
  ENQUIRY_READY
  ENQUIRY_NEEDS_CORRECTION
  QUOTATION_SUBMITTED
  QUOTATION_APPROVED
  QUOTATION_NEEDS_CORRECTION
  QUOTATION_SENT
  QUOTATION_CUSTOMER_APPROVED
  DOCUMENT_SUBMITTED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  DOCUMENT_SHARED
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  SKIPPED
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id])

  type     NotificationType
  title    String
  body     String
  linkPath String?
  data     Json?

  readAt DateTime?

  // email outbox / retry queue
  emailStatus   NotificationDeliveryStatus @default(PENDING)
  emailAttempts Int                        @default(0)
  emailError    String?
  nextAttemptAt DateTime?
  emailSentAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, readAt])
  @@index([emailStatus, nextAttemptAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserNotificationPreference", fields: [userId], references: [id], onDelete: Cascade)

  inAppEnabled Boolean @default(true)
  emailEnabled Boolean @default(true)
  // JSON array of NotificationType values the user has muted
  mutedTypes   Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}
